{
  "name": "@wuhuqif176/dsh-usage-plugin",
  "version": "1.10.0",
  "description": "DeepSeek Harness usage & cost tracker plugin: per-call token/cache-hit stats, peak/off-peak billing, DeepSeek balance query + Qwen/百炼 Token Plan 配额查询, CSV/JSON/PNG export with custom destination, and persistent local storage. Fork of @feiyang666/dsh-usage-plugin.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "usage",
    "cost",
    "tokens",
    "cache",
    "balance"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuhuqif176/dsh-usage-plugin.git"
  },
  "contributors": [
    {
      "name": "Martin-soaring-dev",
      "url": "https://github.com/Martin-soaring-dev"
    },
    {
      "name": "liu3734",
      "url": "https://github.com/liu3734"
    },
    {
      "name": "mumuer1024",
      "url": "https://github.com/mumuer1024"
    }
  ],
  "homepage": "https://github.com/wuhuqif176/dsh-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/wuhuqif176/dsh-usage-plugin/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "wire": "node scripts/wire.js",
    "check": "node scripts/check-package.js",
    "prepublishOnly": "node scripts/check-package.js",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "undici": "^7.0.0"
  }
}